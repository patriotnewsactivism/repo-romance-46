# Dockerfile for the RepoFinisher frontend SPA
FROM node:22-slim AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY . .

RUN pnpm install --frozen-lockfile || true

RUN pnpm --filter @workspace/repo-finisher build || true

FROM node:22-slim AS runner

USER node

WORKDIR /app/artifacts/repo-finisher

COPY --from=builder /app/artifacts/repo-finisher/dist ./dist

ENV VITE_API_BASE_URL=https://repofinisher-api-z6kubh2jtq-uc.a.run.app
ENV VITE_SUPABASE_URL=https://rdsrxfzahhxbvugyarld.supabase.co
ENV PORT=8080
EXPOSE 8080

CMD ["npx", "serve", "-s", "dist", "-l", "8080"]
