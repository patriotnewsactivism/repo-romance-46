# ── Supabase (required) ───────────────────────────────────────────────────────
# The API verifies every bearer token against Supabase before trusting an
# identity, so these must be set for any authenticated route to work.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Secrets at rest (required to store any credential) ────────────────────────
# 32 bytes, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GitHub tokens and user-supplied AI provider keys are sealed with this key
# before they are written to Supabase. Rotating it makes previously sealed
# secrets unreadable — users would need to reconnect GitHub and re-enter keys.
SECRET_ENCRYPTION_KEY=

# ── Change-plan signing (required to plan or execute repository changes) ──────
# HMAC key that makes a change plan tamper-evident between proposal and
# execution. Any long random string; rotating it invalidates in-flight plans.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAN_SIGNING_SECRET=

# ── HTTP ──────────────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated exact origins allowed to call the API. Leave empty when the
# SPA is served from the same origin — an empty list allows same-origin only.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# ── Sentry observability (recommended in staging/production) ──────────────────
# Server-side DSN. Browser failures are relayed through the authenticated API so
# the DSN does not need to be exposed in the frontend bundle.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0.0 disables tracing; 1.0 samples every transaction. Start conservatively.
SENTRY_TRACES_SAMPLE_RATE=0.05
# Optional explicit release. On Vercel the server falls back to the Git commit SHA.
SENTRY_RELEASE=

# ── Frontend build ────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Required when the SPA and API are deployed on different origins.
VITE_API_BASE_URL=
