# RepoFinisher environment reference
#
# Production architecture:
#   frontend -> Vercel
#   API      -> Railway repofinisher-api
#   worker   -> Railway repofinisher-worker
#   auth/db  -> Supabase
#
# Never place private credentials in VITE_* variables.

# ── Browser / Vercel frontend ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://rdsrxfzahhxbvugyarld.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=https://repofinisher-api-production.up.railway.app

# ── Railway API + worker: Supabase ───────────────────────────────────────────
SUPABASE_URL=https://rdsrxfzahhxbvugyarld.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Legacy alias accepted by the code when needed:
SUPABASE_SERVICE_ROLE_KEY=

# ── Trusted repository-write security ────────────────────────────────────────
PLAN_SIGNING_SECRET=
SECRET_ENCRYPTION_KEY=

# ── Railway API runtime ──────────────────────────────────────────────────────
NODE_ENV=production
CORS_ALLOWED_ORIGINS=https://portfolio.donmatthews.live,https://repo-romance-46-swart.vercel.app
LOG_LEVEL=info
REPOFINISHER_WORKER_MODE=railway-persistent

# Railway supplies PORT to the API service at runtime.
# The Dockerfile defaults to 8080 for local/container compatibility.

# ── Railway persistent worker ────────────────────────────────────────────────
RAILWAY_WORKER_CONCURRENCY=2
RAILWAY_WORKER_POLL_MS=3000

# ── AI provider credentials (backend only when platform-managed) ─────────────
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_FREE_API_KEY=
OPENROUTER_API_KEY_2=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Qwen via Alibaba Cloud Model Studio (DashScope). DASHSCOPE_API_KEY is accepted
# as an alias. QWEN_BASE_URL selects the region — keys are NOT valid across
# regions. Must be https. Leave blank for Singapore.
#   Singapore (default): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Beijing:             https://dashscope.aliyuncs.com/compatible-mode/v1
#   US (Virginia):       https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   Hong Kong:           https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1
# Workspace-dedicated and trial domains also exist; see docs/AI_PROVIDERS.md.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=

# ── Source-backed market research ────────────────────────────────────────────
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_RELEASE=

# GitHub OAuth Client ID/Secret do not belong in this file for the current
# browser auth flow. Configure them in Supabase Authentication -> Providers -> GitHub.
