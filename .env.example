# ── Supabase (required) ───────────────────────────────────────────────────────────────────────────────────────
# The API verifies every bearer token against Supabase before trusting an
# identity, so these must be set for any authenticated route to work.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Secrets at rest (required to store any credential) ───────────────────────────────────────────
# 32 bytes, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GitHub tokens and user-supplied AI provider keys are sealed with this key
# before they are written to Supabase. Rotating it makes previously sealed
# secrets unreadable — users would need to reconnect GitHub and re-enter keys.
SECRET_ENCRYPTION_KEY=

# ── Change-plan signing (required to plan or execute repository changes) ──────────────
# HMAC key that makes a change plan tamper-evident between proposal and
# execution. Any long random string; rotating it invalidates in-flight plans.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAN_SIGNING_SECRET=

# ── HTTP ────────────────────────────────────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated exact origins allowed to call the API. Leave empty when the
# SPA is served from the same origin — an empty list allows same-origin only.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# ── Frontend build ─────────────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Required when the SPA and API are deployed on different origins.
VITE_API_BASE_URL=

# ── Sentry observability (recommended in production) ───────────────────────────────────────
# The server DSN is required for API errors and the authenticated browser relay.
# The browser DSN enables direct React errors, performance traces, and readable
# source-mapped stacks. A Sentry DSN is a public ingestion address, not a secret.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_ENVIRONMENT=production
# 0.0 disables tracing; 1.0 samples every transaction. Start conservatively.
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Build-only source-map upload. Never prefix the auth token with VITE_.
# SENTRY_RELEASE normally falls back to VERCEL_GIT_COMMIT_SHA in Vercel builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
