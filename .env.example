# ── Supabase application access (required) ─────────────────────────────────────────────
# The API verifies Supabase bearer tokens before trusting user identity.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Privileged backend-only access. Required for service-role-only operations such
# as Supabase Vault AI BYOK storage/read/delete. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── GitHub credential sealing (backend only) ───────────────────────────────────────────
# 32 bytes, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GitHub connection tokens currently use this sealed-secret layer.
# AI BYOK keys DO NOT use this key; they are stored in Supabase Vault.
# Rotating this without a credential migration can make previously sealed
# GitHub tokens unreadable and require users to reconnect GitHub.
SECRET_ENCRYPTION_KEY=

# ── Change-plan signing (required for repository writes) ────────────────────────────────
# HMAC key that makes a prepared change plan tamper-evident between approval
# and execution. Rotating it invalidates in-flight plans.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAN_SIGNING_SECRET=

# ── HTTP / API runtime (Render) ────────────────────────────────────────────────────────
PORT=5000
# Comma-separated exact origins allowed to call the API in addition to the
# first-party origins compiled into the server allowlist.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# ── Platform AI fallback credentials (Render only; optional) ───────────────────────────
# User BYOK credentials saved through Settings/Supabase Vault take precedence.
# Never put these values in VITE_* variables or Netlify browser configuration.
AI_PROVIDER=openrouter
AI_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

GEMINI_API_KEY=
# GOOGLE_API_KEY=                 # supported alias for GEMINI_API_KEY
GEMINI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Frontend build (Netlify; browser-visible values only) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_API_BASE_URL=https://repofinisher-api-live.onrender.com

# ── Sentry observability (recommended in production) ───────────────────────────────────
# A Sentry DSN is an ingestion address and may be present in browser configuration.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Build-only source-map upload. Never prefix the auth token with VITE_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set explicitly to a deployment/release identifier (normally the Git commit SHA).
SENTRY_RELEASE=
