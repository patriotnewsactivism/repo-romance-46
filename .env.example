# RepoFinisher environment reference
#
# Production architecture:
#   frontend -> Vercel
#   API      -> Contabo repofinisher-api
#   worker   -> Contabo repofinisher-worker
#   auth/db  -> self-hosted Postgres + first-party auth
#
# Never place private credentials in VITE_* variables.

# ── Browser / Vercel frontend ────────────────────────────────────────────────
VITE_API_BASE_URL=https://api.portfolio.donmatthews.live

# ── Contabo API + worker: Postgres ───────────────────────────────────────────
# Self-hosted database. No Supabase project is involved.
DATABASE_URL=postgres://user:password@host:5432/bluebook

# ── First-party auth: GitHub OAuth app ───────────────────────────────────────
# Create at https://github.com/settings/developers with the callback URL
# <PUBLIC_ORIGIN>/api/auth/github/callback. Email/password sign-in works without it.
PUBLIC_ORIGIN=https://portfolio.donmatthews.live
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── Trusted repository-write security ────────────────────────────────────────
PLAN_SIGNING_SECRET=
SECRET_ENCRYPTION_KEY=

# ── Contabo API runtime ──────────────────────────────────────────────────────
NODE_ENV=production
CORS_ALLOWED_ORIGINS=https://portfolio.donmatthews.live,https://repo-romance-46-swart.vercel.app
LOG_LEVEL=info
REPOFINISHER_WORKER_MODE=persistent

# Docker Compose sets PORT=8080 on Contabo; Caddy terminates HTTPS.

# ── Contabo persistent worker ────────────────────────────────────────────────
REPOFINISHER_WORKER_CONCURRENCY=2
REPOFINISHER_WORKER_POLL_MS=3000

# ── AI provider credentials (backend only when platform-managed) ─────────────
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_FREE_API_KEY=
OPENROUTER_API_KEY_2=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Qwen via Alibaba Cloud Model Studio (DashScope). DASHSCOPE_API_KEY is accepted
# as an alias. QWEN_BASE_URL selects the region — keys are NOT valid across
# regions. Must be https. Leave blank for Singapore.
#   Singapore (default): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Beijing:             https://dashscope.aliyuncs.com/compatible-mode/v1
#   US (Virginia):       https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   Hong Kong:           https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1
# Workspace-dedicated and trial domains also exist; see docs/AI_PROVIDERS.md.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=

# ── Source-backed market research ────────────────────────────────────────────
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_RELEASE=

# GitHub OAuth Client ID/Secret are server-only (see GITHUB_OAUTH_* above).

# ── Apex <-> Think Tank self-heal loop (GitHub Actions secrets/vars, not runtime env) ──
# Used by .github/workflows/apex-thinktank-sync.yml. Never put these in VITE_*.
# Secret: READ-ONLY bearer token for Apex GET /api/health/components.
APEX_API_KEY=
# Secret: fine-grained PAT scoped to patriotnewsactivism/Apex only (contents + pull requests write).
APEX_REPO_TOKEN=
# Variables: Apex base URL, Think Tank base URL, and the opt-in switch (anything but "true" = dry run).
APEX_BASE_URL=
THINKTANK_ENDPOINT=https://debate.donmatthews.live
APEX_SYNC_LIVE=false
