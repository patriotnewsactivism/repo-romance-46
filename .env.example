# RepoFinisher environment reference
# Never place private credentials in a VITE_* variable. VITE_* values are
# embedded into browser assets and must be treated as public.

# ── Supabase: API authentication / user-scoped client (required) ──────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# ── Supabase: trusted server operations (required for Vault-backed BYOK) ──────
# BACKEND ONLY. Never expose this value to the browser or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Legacy/server-sealed credentials (required for stored GitHub credentials) ─
# 32 bytes, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# AI BYOK provider keys are stored in Supabase Vault and do NOT use this as
# their primary storage mechanism. This key is still used by server-sealed
# credentials such as stored GitHub connections/legacy encrypted envelopes.
# Rotating it can make previously sealed values unreadable until users reconnect
# or the original key is restored.
SECRET_ENCRYPTION_KEY=

# ── Change-plan signing (required before repository writes) ──────────────────
# HMAC key that makes a generated plan tamper-evident between proposal and
# execution. Rotating it invalidates in-flight approvals/plans.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAN_SIGNING_SECRET=

# ── HTTP / API runtime ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Comma-separated exact additional origins allowed to call the API.
# First-party production origins are also represented in server configuration.
# Do not use a wildcard to work around an authenticated CORS problem.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# ── Frontend build (Netlify) ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# Required because the SPA and persistent API are deployed on different hosts.
VITE_API_BASE_URL=https://repofinisher-api-live.onrender.com

# ── Optional platform AI fallback ─────────────────────────────────────────────
# Users may supply their own provider/model credential in Settings; BYOK values
# are stored server-side in Supabase Vault. These variables are optional backend
# fallbacks and must never be exposed as VITE_* values.
AI_PROVIDER=google
AI_MODEL=

GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Sentry observability (recommended in production) ─────────────────────────
# DSNs are ingestion addresses and may be browser-visible. Auth tokens are not.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Build-only source-map upload. Never prefix SENTRY_AUTH_TOKEN with VITE_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Use an immutable release/commit identifier supplied by CI/hosting when possible.
SENTRY_RELEASE=

# Production hosting policy:
#   frontend = Netlify
#   persistent API = Render
#   auth/database/Vault = Supabase
# Vercel is not an approved RepoFinisher deployment target.
