# RepoFinisher environment reference
# Never place private credentials in a VITE_* variable. VITE_* values are
# embedded into browser assets and must be treated as public.

# ── Supabase: API authentication / user-scoped client (required) ──────────────
SUPABASE_URL=https://rdsrxfzahhxbvugyarld.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# ── Supabase: trusted server operations (required for Vault-backed BYOK) ──────
# BACKEND ONLY. Never expose these values to the browser or prefix them with VITE_.
# Either name is accepted by the API. Production Cloud Run currently binds the
# Secret Manager value as SUPABASE_SECRET_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Legacy/server-sealed credentials (required for stored GitHub credentials) ─
# CRITICAL FIX: SECRET_ENCRYPTION_KEY MUST be sourced from Google Secret Manager
# and its actual encryption logic should use KMS.
# Set its SECRET_NAME here. The actual value will be injected by Cloud Run.
SECRET_ENCRYPTION_KEY_SECRET_NAME=repofinisher-secret-encryption-key
# For KMS-backed envelope encryption, also define the KMS key resource name.
# Format: projects/PROJECT_ID/locations/LOCATION/keyRings/KEY_RING_ID/cryptoKeys/KEY_ID
KMS_KEY_NAME=projects/your-gcp-project/locations/us-central1/keyRings/repofinisher-keyring/cryptoKeys/repofinisher-encryption-key

# ── Change-plan signing (required before repository writes) ─────────────────
# Long random HMAC key. Rotating it invalidates in-flight approvals/plans.
# CRITICAL FIX: PLAN_SIGNING_SECRET MUST be sourced from Google Secret Manager.
# Set its SECRET_NAME here. The actual value will be injected by Cloud Run.
PLAN_SIGNING_SECRET_SECRET_NAME=repofinisher-plan-signing-secret

# ── HTTP / API runtime ───────────────────────────────────────────────
NODE_ENV=production
# Cloud Run injects PORT automatically.
PORT=8080
# Production API must accept the verified canonical custom hostname and the
# direct Cloud Run frontend hostname. Never use '*'.
CORS_ALLOWED_ORIGINS=https://portfolio.donmatthews.live,https://repofinisher-web-z6kubh2jtq-uc.a.run.app
LOG_LEVEL=info
# Source maps should be externalized in production builds, not enabled at runtime.
NODE_OPTIONS=--enable-source-maps

# ── Cloud Run worker plane ─────────────────────────────────────────────
# API service: true. Completion-session Job: false.
CLOUD_RUN_JOBS_ENABLED=true
GCP_PROJECT_ID=repofinish
GCP_REGION=us-central1
COMPLETION_SESSION_JOB=repofinisher-completion-session
# NEW: Pub/Sub topic for event-driven architecture (EDA)
PUBSUB_TOPIC_EVENTS=repofinisher-events

# ── Frontend build (Cloud Run) ────────────────────────────────────────────
VITE_SUPABASE_URL=https://rdsrxfzahhxbvugyarld.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# The SPA calls the persistent Cloud Run API directly. The verified canonical
# browser hostname is portfolio.donmatthews.live, mapped to repofinisher-web.
# VITE_API_BASE_URL can point to a lightweight API Gateway for caching/BFF.
VITE_API_BASE_URL=https://repofinisher-api-z6kubh2jtq-uc.a.run.app

# ── AI provider credentials ───────────────────────────────────────────────
# The model is selected inside RepoFinisher and saved with the user's app
# preferences. Do NOT duplicate model IDs in Cloud Run ENV or Secret Manager.
# Provider API keys are the only AI secrets. User BYOK keys are stored separately
# per provider in Supabase Vault, so switching providers does not erase another
# provider's credential.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_FREE_API_KEY=
OPENROUTER_API_KEY_2=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Source-backed live market research ─────────────────────────────────────
# BACKEND ONLY. When unset, RepoFinisher must report external competitor/pricing
# research as unavailable rather than inventing market facts.
TAVILY_API_KEY=
# Supported by the Tavily Search API. "advanced" favors research quality over cost.
TAVILY_SEARCH_DEPTH=advanced

# ── Sentry observability ───────────────────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_RELEASE=
# Sentry secrets should be sourced from Secret Manager.
SENTRY_AUTH_TOKEN_SECRET_NAME=repofinisher-sentry-auth-token
SENTRY_ORG_SECRET_NAME=repofinisher-sentry-org
SENTRY_PROJECT_SECRET_NAME=repofinisher-sentry-project

# ── Operational Controls ───────────────────────────────────────────────
# NEW: Minimum instances for Cloud Run services to mitigate cold starts.
MIN_API_INSTANCES=1
MIN_WEB_INSTANCES=1
# NEW: Global Kill Switch for autonomous operations.
# true means the Kill Switch feature is ENABLED (available to be engaged via API/DB).
# false means the Kill Switch feature is DISABLED (no autonomous operations can be halted via Kill Switch).
# For runtime override, workers poll kill_switch_status in Supabase.
KILL_SWITCH_ENABLED=true
# NEW: Internal API Versioning
API_VERSIONING_ENABLED=true
API_CURRENT_VERSION=v1

# Production hosting policy:
#   canonical frontend = https://portfolio.donmatthews.live
#   frontend service = Google Cloud Run repofinisher-web
#   API/control plane = Google Cloud Run repofinisher-api
#   long-running completion sessions = Google Cloud Run Job
#   auth/database/Vault = Supabase
#   source/CI = GitHub / GitHub Actions
# Vercel is not an approved deployment target.
# netlify.toml has been removed.
