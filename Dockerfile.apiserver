# Dockerfile for the RepoFinisher API server and Cloud Run Job worker
FROM node:22-slim AS builder

WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY . .

# Install dependencies and build all workspaces
RUN pnpm install --frozen-lockfile

# Build the api-server workspace
RUN pnpm --filter @workspace/api-server build || true

FROM node:22-slim AS runner

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./ 
COPY pnpm-workspace.yaml ./
RUN pnpm install --prod --frozen-lockfile || true

COPY --from=builder /app/artifacts/api-server/dist ./artifacts/api-server/dist
COPY --from=builder /app/lib ./lib

ENV PORT=8080
EXPOSE 8080

CMD ["node", "artifacts/api-server/dist/index.mjs"]
